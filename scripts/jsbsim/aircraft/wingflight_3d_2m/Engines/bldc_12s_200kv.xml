<?xml version="1.0"?>
<!--
  12S outrunner for a 2 m class 3D aircraft (Hacker A60 / Scorpion 5025 class).
  JSBSim's brushless DC model: current = (throttle * maxvolts - rpm / Kv) / R,
  torque = (current - noloadcurrent) / Kt.

  coilresistance is the *effective* loop resistance (motor ~0.03 ohm + 12S
  pack internal resistance + ESC/wiring), which is what limits the peak current
  to a realistic ~110-130 A at full throttle, static.
-->
<brushless_dc_motor name="BLDC 12S 200Kv">
  <velocityconstant> 200 </velocityconstant>
  <coilresistance> 0.08 </coilresistance>
  <noloadcurrent> 2.0 </noloadcurrent>
  <maxvolts> 44.4 </maxvolts>
</brushless_dc_motor>
