            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/coefficient/CL_elevator">
        <description> Tail lift due to elevator (tail q incl. prop wash) </description>
        <product>
          <property> aero/function/qbar-tail-psf </property>
          <property> metrics/Sw-sqft </property>
          <table>
            <independentVar lookup="row"> fcs/elevator-pos-rad </independentVar>
            <tableData>
              -0.785  -0.260
              -0.524  -0.210
              -0.349  -0.155
              -0.175  -0.085
