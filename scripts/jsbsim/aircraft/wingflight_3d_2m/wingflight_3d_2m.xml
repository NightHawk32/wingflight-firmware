<?xml version="1.0"?>
<!--
  Generic 2 m class 3D aerobatic RC aircraft (Extra 330 / Edge 540 style),
  12S electric, for Wingflight SITL via scripts/jsbsim_bridge.py.

  Not a model of any specific kit - a physically consistent baseline built from
  typical geometry, meant to be tuned. All tunables are in this file; the
  rationale and the derivation of each number are in
  docs/development/SITL 3D Aircraft Model.md.

  Frames: structural X aft, Y right, Z up, origin at the spinner.
  The moment tables are written about the CG, so AERORP == CG.

  Coverage: lift/drag/pitch tables span alpha -180..180 deg and the side-force
  and yaw tables span beta -90..90 deg (JSBSim's ranges), so hover, harrier,
  knife-edge, tail slides and flat spins stay inside the data instead of
  clamping at a stall-angle table edge.

  Prop wash: elevator, rudder and ailerons see a dynamic pressure that includes
  the propeller slipstream (u + 2 * induced velocity, momentum theory), so the
  aircraft keeps control authority - and tail damping - at zero airspeed while
  hovering. Flow along body X is signed, so controls reverse in a tail slide.
-->
<fdm_config name="Wingflight 3D 2m" version="2.0" release="ALPHA"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

  <fileheader>
    <author> Wingflight </author>
    <filecreationdate> 2026-09-13 </filecreationdate>
    <version> 0.1 </version>
    <description> Generic 2 m 3D aerobatic RC aircraft, 12S electric, 6.5 kg </description>
  </fileheader>

  <metrics>
    <wingarea unit="M2"> 0.95 </wingarea>
    <wingspan unit="M"> 2.00 </wingspan>
    <chord unit="M"> 0.475 </chord>
    <htailarea unit="M2"> 0.22 </htailarea>
    <htailarm unit="M"> 0.95 </htailarm>
    <vtailarea unit="M2"> 0.14 </vtailarea>
    <vtailarm unit="M"> 0.95 </vtailarm>
    <location name="AERORP" unit="M">
      <x> 0.60 </x> <y> 0 </y> <z> 0 </z>
    </location>
    <location name="EYEPOINT" unit="M">
      <x> 0.55 </x> <y> 0 </y> <z> 0.10 </z>
    </location>
    <location name="VRP" unit="M">
      <x> 0.60 </x> <y> 0 </y> <z> 0 </z>
    </location>
  </metrics>

  <mass_balance>
    <!-- Radii of gyration typical for 2 m aerobatic models:
         Ixx ~ m (0.26 b/2)^2, Iyy ~ m (0.37 L/2)^2, Izz ~ Ixx + Iyy. -->
    <ixx unit="KG*M2"> 0.45 </ixx>
    <iyy unit="KG*M2"> 0.85 </iyy>
    <izz unit="KG*M2"> 1.20 </izz>
    <ixz unit="KG*M2"> 0 </ixz>
    <emptywt unit="KG"> 6.5 </emptywt>
    <location name="CG" unit="M">
      <x> 0.60 </x> <y> 0 </y> <z> 0 </z>
    </location>
  </mass_balance>

  <ground_reactions>
    <!-- Taildragger. Mains carry ~90 % of 64 N with ~1 cm static compression.
         Structure contacts (wingtips, nose, fin) are deliberately soft: with
         only 0.45 kg m2 roll inertia, a stiff contact on a 1 m lever has a
         rotational time constant of ~2 ms - shorter than the 2 ms-8 ms
         integration step - and blows the state up to NaN on a wingtip strike.
         Stability needs damping * lever^2 / inertia * dt well below 1. -->
    <contact type="BOGEY" name="LEFT_MAIN">
      <location unit="M"> <x> 0.45 </x> <y> -0.20 </y> <z> -0.28 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.05 </rolling_friction>
      <spring_coeff unit="N/M"> 2900 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 150 </damping_coeff>
      <max_steer unit="DEG"> 0 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 0 </retractable>
    </contact>
    <contact type="BOGEY" name="RIGHT_MAIN">
      <location unit="M"> <x> 0.45 </x> <y> 0.20 </y> <z> -0.28 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.05 </rolling_friction>
      <spring_coeff unit="N/M"> 2900 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 150 </damping_coeff>
      <max_steer unit="DEG"> 0 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 0 </retractable>
    </contact>
    <contact type="BOGEY" name="TAIL">
      <location unit="M"> <x> 1.75 </x> <y> 0 </y> <z> -0.10 </z> </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <rolling_friction> 0.05 </rolling_friction>
      <spring_coeff unit="N/M"> 1000 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 50 </damping_coeff>
      <max_steer unit="DEG"> 30 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 0 </retractable>
    </contact>
    <contact type="STRUCTURE" name="LEFT_WINGTIP">
      <location unit="M"> <x> 0.65 </x> <y> -1.00 </y> <z> 0 </z> </location>
      <static_friction> 0.5 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="N/M"> 1500 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 25 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="RIGHT_WINGTIP">
      <location unit="M"> <x> 0.65 </x> <y> 1.00 </y> <z> 0 </z> </location>
      <static_friction> 0.5 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="N/M"> 1500 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 25 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="NOSE">
      <location unit="M"> <x> 0 </x> <y> 0 </y> <z> 0 </z> </location>
      <static_friction> 0.5 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="N/M"> 1500 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 25 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="FIN_TOP">
      <location unit="M"> <x> 1.85 </x> <y> 0 </y> <z> 0.30 </z> </location>
      <static_friction> 0.5 </static_friction>
      <dynamic_friction> 0.4 </dynamic_friction>
      <spring_coeff unit="N/M"> 1500 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 25 </damping_coeff>
    </contact>
  </ground_reactions>

  <propulsion>
    <engine file="bldc_12s_200kv">
      <feed> 0 </feed>
      <thruster file="prop_22x10e">
        <location unit="M"> <x> -0.03 </x> <y> 0 </y> <z> 0 </z> </location>
        <orient unit="DEG"> <roll> 0 </roll> <pitch> 0 </pitch> <yaw> 0 </yaw> </orient>
        <sense> 1 </sense>
        <p_factor> 0 </p_factor>
      </thruster>
    </engine>
  </propulsion>

  <flight_control name="FCS: 3D 2m">
    <!-- Servos: ~0.1 s / 60 deg, i.e. full 90 deg travel (norm span 2) in
         ~0.15 s -> rate limit 12 norm/s. Throws: 3D rates, full stick = full
         deflection. Expo/dual rates belong in the FC or the radio. -->
    <channel name="Pitch">
      <summer name="fcs/pitch-trim-sum">
        <input> fcs/elevator-cmd-norm </input>
        <input> fcs/pitch-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <actuator name="fcs/elevator-servo">
        <input> fcs/pitch-trim-sum </input>
        <rate_limit> 12 </rate_limit>
      </actuator>
      <aerosurface_scale name="fcs/elevator-control">
        <input> fcs/elevator-servo </input>
        <range> <min> -0.785 </min> <max> 0.785 </max> </range>
        <output> fcs/elevator-pos-rad </output>
      </aerosurface_scale>
      <!-- *-pos-norm feed the FlightGear native-FDM stream (surface animations). -->
      <pure_gain name="fcs/elevator-norm">
        <input> fcs/elevator-servo </input>
        <gain> 1 </gain>
        <output> fcs/elevator-pos-norm </output>
      </pure_gain>
    </channel>

    <channel name="Roll">
      <summer name="fcs/roll-trim-sum">
        <input> fcs/aileron-cmd-norm </input>
        <input> fcs/roll-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <actuator name="fcs/aileron-servo">
        <input> fcs/roll-trim-sum </input>
        <rate_limit> 12 </rate_limit>
      </actuator>
      <aerosurface_scale name="fcs/left-aileron-control">
        <input> fcs/aileron-servo </input>
        <range> <min> -0.611 </min> <max> 0.611 </max> </range>
        <output> fcs/left-aileron-pos-rad </output>
      </aerosurface_scale>
      <aerosurface_scale name="fcs/right-aileron-control">
        <input> fcs/aileron-servo </input>
        <range> <min> 0.611 </min> <max> -0.611 </max> </range>
        <output> fcs/right-aileron-pos-rad </output>
      </aerosurface_scale>
      <pure_gain name="fcs/left-aileron-norm">
        <input> fcs/aileron-servo </input>
        <gain> 1 </gain>
        <output> fcs/left-aileron-pos-norm </output>
      </pure_gain>
      <!-- Same sign as the left one: FlightGear models (FGJSBsim convention)
           expect right-aileron-pos-norm = +roll command and mirror it in the
           animation. -1 here drew the right aileron reversed. -->
      <pure_gain name="fcs/right-aileron-norm">
        <input> fcs/aileron-servo </input>
        <gain> 1 </gain>
        <output> fcs/right-aileron-pos-norm </output>
      </pure_gain>
    </channel>

    <channel name="Yaw">
      <summer name="fcs/yaw-trim-sum">
        <input> fcs/rudder-cmd-norm </input>
        <input> fcs/yaw-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <actuator name="fcs/rudder-servo">
        <input> fcs/yaw-trim-sum </input>
        <rate_limit> 12 </rate_limit>
      </actuator>
      <aerosurface_scale name="fcs/rudder-control">
        <input> fcs/rudder-servo </input>
        <range> <min> -0.785 </min> <max> 0.785 </max> </range>
        <output> fcs/rudder-pos-rad </output>
      </aerosurface_scale>
      <!-- Negated: JSBSim's rudder + is nose left, FlightGear's
           rudder-pos-norm + is trailing edge right (FGJSBsim negates it too). -->
      <pure_gain name="fcs/rudder-norm">
        <input> fcs/rudder-servo </input>
        <gain> -1 </gain>
        <output> fcs/rudder-pos-norm </output>
      </pure_gain>
    </channel>
  </flight_control>

  <aerodynamics>

    <!-- ===== Helper functions ===== -->

    <function name="aero/function/cos2-beta">
      <product>
        <cos> <property> aero/beta-rad </property> </cos>
        <cos> <property> aero/beta-rad </property> </cos>
      </product>
    </function>

    <function name="aero/function/sin2-beta">
      <product>
        <sin> <property> aero/beta-rad </property> </sin>
        <sin> <property> aero/beta-rad </property> </sin>
      </product>
    </function>

    <!-- Fully developed slipstream velocity along body X (momentum theory). -->
    <function name="aero/function/u-wash-fps">
      <sum>
        <property> velocities/u-aero-fps </property>
        <product>
          <value> 2 </value>
          <property> propulsion/engine/prop-induced-velocity_fps </property>
        </product>
      </sum>
    </function>

    <!-- Signed dynamic pressure on the tail surfaces: 60 % of the tail is in
         the slipstream, the rest sees the free-stream flow along body X. -->
    <function name="aero/function/qbar-tail-psf">
      <product>
        <value> 0.5 </value>
        <property> atmosphere/rho-slugs_ft3 </property>
        <sum>
          <product>
            <value> 0.6 </value>
            <property> aero/function/u-wash-fps </property>
            <abs> <property> aero/function/u-wash-fps </property> </abs>
          </product>
          <product>
            <value> 0.4 </value>
            <property> velocities/u-aero-fps </property>
            <abs> <property> velocities/u-aero-fps </property> </abs>
          </product>
        </sum>
      </product>
    </function>

    <!-- Ailerons: only the inboard ~25 % sits in the slipstream. -->
    <function name="aero/function/qbar-aileron-psf">
      <product>
        <value> 0.5 </value>
        <property> atmosphere/rho-slugs_ft3 </property>
        <sum>
          <product>
            <value> 0.25 </value>
            <property> aero/function/u-wash-fps </property>
            <abs> <property> aero/function/u-wash-fps </property> </abs>
          </product>
          <product>
            <value> 0.75 </value>
            <property> velocities/u-aero-fps </property>
            <abs> <property> velocities/u-aero-fps </property> </abs>
          </product>
        </sum>
      </product>
    </function>

    <!-- Effective velocity for tail rate damping (keeps damping in a hover). -->
    <function name="aero/function/v-damp-tail-fps">
      <sum>
        <product>
          <value> 0.6 </value>
          <abs> <property> aero/function/u-wash-fps </property> </abs>
        </product>
        <product>
          <value> 0.4 </value>
          <property> velocities/vt-fps </property>
        </product>
      </sum>
    </function>

    <!-- ===== DRAG ===== -->
    <axis name="DRAG">
      <function name="aero/coefficient/CD_alpha">
        <description> Drag vs alpha, 360 deg: CD0 0.035, k 0.095, flat plate CD90 1.42 </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> aero/function/cos2-beta </property>
          <table>
            <independentVar lookup="row"> aero/alpha-deg </independentVar>
            <tableData>
              -180  0.050
              -170  0.100
              -165  0.140
              -150  0.400
              -135  0.740
              -120  1.070
              -105  1.320
               -90  1.420
               -75  1.320
               -60  1.070
               -45  0.740
               -35  0.550
               -25  0.360
               -18  0.200
               -14  0.126
               -10  0.087
