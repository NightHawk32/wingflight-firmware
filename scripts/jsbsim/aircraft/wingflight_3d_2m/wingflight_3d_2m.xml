                90  1.420
               105  1.320
               120  1.070
               135  0.740
               150  0.400
               165  0.140
               170  0.100
               180  0.050
            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/coefficient/CD_beta">
        <description> Fuselage/fin side area drag in sideslip </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> aero/function/sin2-beta </property>
          <value> 0.60 </value>
        </product>
      </function>

      <function name="aero/coefficient/CD_controls">
        <description> Drag due to control deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <sum>
            <product> <value> 0.15 </value> <abs> <property> fcs/elevator-pos-rad </property> </abs> </product>
            <product> <value> 0.08 </value> <abs> <property> fcs/rudder-pos-rad </property> </abs> </product>
            <product> <value> 0.05 </value> <abs> <property> fcs/left-aileron-pos-rad </property> </abs> </product>
          </sum>
        </product>
      </function>
    </axis>

    <!-- ===== SIDE ===== -->
    <axis name="SIDE">
      <function name="aero/coefficient/CY_beta">
        <description> Side force vs beta: large 3D fuselage side area (knife-edge) </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <table>
            <independentVar lookup="row"> aero/beta-deg </independentVar>
            <tableData>
              -90   0.00
              -75   0.14
              -60   0.24
              -45   0.28
              -30   0.26
              -20   0.22
              -10   0.12
               -5   0.06
                0   0.00
                5  -0.06
               10  -0.12
               20  -0.22
               30  -0.26
               45  -0.28
               60  -0.24
               75  -0.14
               90   0.00
            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/coefficient/CY_rudder">
        <description> Side force due to rudder (tail q incl. prop wash) </description>
        <product>
          <property> aero/function/qbar-tail-psf </property>
          <property> metrics/Sw-sqft </property>
          <table>
            <independentVar lookup="row"> fcs/rudder-pos-rad </independentVar>
            <tableData>
              -0.785  -0.150
              -0.524  -0.120
              -0.349  -0.090
              -0.175  -0.050
               0.000   0.000
               0.175   0.050
               0.349   0.090
               0.524   0.120
               0.785   0.150
            </tableData>
          </table>
        </product>
      </function>
    </axis>

    <!-- ===== LIFT ===== -->
    <axis name="LIFT">
      <function name="aero/coefficient/CL_alpha">
        <description> Lift vs alpha, 360 deg: CLa 4.35/rad, gentle stall at 14 deg, flat plate beyond </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> aero/function/cos2-beta </property>
          <table>
            <independentVar lookup="row"> aero/alpha-deg </independentVar>
            <tableData>
              -180   0.00
              -175   0.23
