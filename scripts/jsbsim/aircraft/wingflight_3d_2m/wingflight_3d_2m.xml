    </axis>

    <!-- ===== ROLL ===== -->
    <axis name="ROLL">
      <function name="aero/coefficient/Cl_beta">
        <description> Dihedral effect (mid wing, fin above CG) </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <table>
            <independentVar lookup="row"> aero/beta-deg </independentVar>
            <tableData>
              -90   0.010
              -30   0.016
                0   0.000
               30  -0.016
               90  -0.010
            </tableData>
          </table>
        </product>
      </function>

      <function name="aero/coefficient/Cl_p">
        <description> Roll damping, Clp -0.45 (0.25 rho V S b^2 Clp p) </description>
        <product>
          <value> -0.1125 </value>
          <property> atmosphere/rho-slugs_ft3 </property>
          <property> velocities/vt-fps </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <property> metrics/bw-ft </property>
          <property> velocities/p-aero-rad_sec </property>
        </product>
      </function>

      <function name="aero/coefficient/Cl_r">
        <description> Roll due to yaw rate, Clr 0.10 </description>
        <product>
          <value> 0.025 </value>
          <property> atmosphere/rho-slugs_ft3 </property>
          <property> velocities/vt-fps </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <property> metrics/bw-ft </property>
          <property> velocities/r-aero-rad_sec </property>
        </product>
      </function>

      <function name="aero/coefficient/Cl_aileron">
        <description> Roll due to aileron, 0.30/rad saturating (aileron q incl. inboard prop wash) </description>
        <product>
          <property> aero/function/qbar-aileron-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <table>
            <independentVar lookup="row"> fcs/left-aileron-pos-rad </independentVar>
            <tableData>
              -0.611  -0.145
              -0.524  -0.130
              -0.349  -0.095
              -0.175  -0.052
