    </axis>

    <!-- ===== PITCH ===== -->
    <axis name="PITCH">
      <function name="aero/coefficient/Cm_alpha">
        <description> Pitch moment vs alpha about CG: 5 % static margin, tail restoring post-stall, unstable tail-first </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> aero/function/cos2-beta </property>
          <table>
            <independentVar lookup="row"> aero/alpha-deg </independentVar>
            <tableData>
              -180   0.00
              -165   0.10
              -150   0.25
