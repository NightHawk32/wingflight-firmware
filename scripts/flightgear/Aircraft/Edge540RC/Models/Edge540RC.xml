<?xml version="1.0"?>
<!--
  FGAddon's full-scale Edge 540 (7.41 m span) scaled to the 2.0 m span of
  scripts/jsbsim/aircraft/wingflight_3d_2m: 2.0 / 7.41 = 0.27.

  The native-FDM stream places the model origin at the JSBSim VRP, which the 3D
  model puts at its CG. The Edge model's origin is 13.4 in (0.34 m) ahead of and
  47.6 in (1.21 m) below its CG (ZivkoEdge540-jsbsim.xml), so shift it by that
  first; the scale animation below scales the offsets along with the mesh.
-->
<PropertyList>
  <model>
    <name>edge</name>
    <path>Aircraft/ZivkoEdge/Models/ZivkoEdge540.xml</path>
    <offsets>
      <x-m>-0.34</x-m>
      <y-m>0</y-m>
      <z-m>-1.21</z-m>
    </offsets>
  </model>

  <animation>
    <type>scale</type>
    <object-name>edge</object-name>
    <!-- No property: the scale is the constant x/y/z-offset. Factors 0 so the
         first frame isn't drawn at 1 + offset. -->
    <x-factor>0</x-factor>
    <y-factor>0</y-factor>
    <z-factor>0</z-factor>
    <x-offset>0.27</x-offset>
    <y-offset>0.27</y-offset>
    <z-offset>0.27</z-offset>
  </animation>
</PropertyList>
