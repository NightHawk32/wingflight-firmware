# Wingflight / RP2350A - Raspberry Pi Pico 2 bench board
#
# Firmware: RP2350A build of RP2350_UNIFIED.
# Wiring: Pico2-SDcard-Test.md (follows RP235XB-Reference-Pinout.md
# where the Pico 2 header allows it).
#
# Paste into the CLI after `defaults nosave`.

# feature
feature RX_SERIAL
feature SOFTSERIAL
feature TELEMETRY

# serial
# SOFTSERIAL1 (30): FBUS receiver, single wire on GPIO5
serial 30 64 115200 57600 0 115200

# resources
resource LED 1 A25
resource SERIAL_TX 1 A12
resource SERIAL_RX 1 A13
resource SERIAL_BIDIR_EN 1 A09
resource SPI_SCK 1 A18
resource SPI_MISO 1 A16
resource SPI_MOSI 1 A19
resource GYRO_CS 1 A17
resource GYRO_EXTI 1 A11
resource SPI_SCK 2 A26
resource SPI_MISO 2 A28
resource SPI_MOSI 2 A27
resource SDCARD_CS 1 A22
resource SERIAL_TX 11 A05

# master
set serialrx_provider = FBUS
set serialrx_inverted = ON
set serialrx_halfduplex = ON
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set sdcard_mode = SPI
set sdcard_spi_bus = 2
set blackbox_device = SDCARD

save
